# Local development (recommended):
#   Copy this file to ".env.local" (gitignored via .env.*) and run:
#     .\compose-local.ps1 up -d
#   or  .\start-local.ps1
#   or  $env:COMPOSE_ENV_FILES='.env.local'; docker compose up -d
#
# Optional: copy to ".env" instead — Compose auto-loads ".env" only (not ".env.local").
# Keep production values in ".env.production.example" (template) and secret stores.
# Never commit real passwords or production RDS endpoints.

# --- Local PostgreSQL on your laptop ---
# Docker containers reach your Windows/macOS/Linux host through host.docker.internal.
# Create the databases/users locally first, for example with infra/postgres/create-microservice-databases.sql.

# Keep local PostgreSQL connection usage low across many microservices.
DB_POOL_MAX_SIZE=2
DB_POOL_MIN_IDLE=0

# Per-service DB credentials.
AUTH_DB_PASSWORD=authdb
USER_DB_PASSWORD=userdb
SHOP_DB_PASSWORD=shopdb
PRODUCT_DB_PASSWORD=productdb
ORDER_DB_PASSWORD=orderdb
STOCK_DB_PASSWORD=stockdb
PAYMENT_DB_PASSWORD=paymentdb
NOTIFICATION_DB_PASSWORD=notificationdb
REPORTING_DB_PASSWORD=reportingdb
FIELDFORCE_DB_PASSWORD=fieldforcedb
ACCOUNT_DB_PASSWORD=accountdb
DOCTOR_DB_PASSWORD=doctordb
APPOINTMENT_DB_PASSWORD=appointmentdb
QUEUE_DB_PASSWORD=queuedb

# Per-service JDBC endpoints for local host PostgreSQL.
AUTH_DB_URL=jdbc:postgresql://host.docker.internal:5432/authdb
AUTH_DB_USERNAME=authdb
USER_DB_URL=jdbc:postgresql://host.docker.internal:5432/userdb
USER_DB_USERNAME=userdb
SHOP_DB_URL=jdbc:postgresql://host.docker.internal:5432/shopdb
SHOP_DB_USERNAME=shopdb
# Optional: mirror new shops to fieldforce-service (e.g. http://localhost:8090 when running it locally).
# SHOP_INTEGRATION_FIELDFORCE_BASE_URL=

PRODUCT_DB_URL=jdbc:postgresql://host.docker.internal:5432/productdb
PRODUCT_DB_USERNAME=productdb
ORDER_DB_URL=jdbc:postgresql://host.docker.internal:5432/orderdb
ORDER_DB_USERNAME=orderdb
STOCK_DB_URL=jdbc:postgresql://host.docker.internal:5432/stockdb
STOCK_DB_USERNAME=stockdb
PAYMENT_DB_URL=jdbc:postgresql://host.docker.internal:5432/paymentdb
PAYMENT_DB_USERNAME=paymentdb
NOTIFICATION_DB_URL=jdbc:postgresql://host.docker.internal:5432/notificationdb
NOTIFICATION_DB_USERNAME=notificationdb
REPORTING_DB_URL=jdbc:postgresql://host.docker.internal:5432/reportingdb
REPORTING_DB_USERNAME=reportingdb
FIELDFORCE_DB_URL=jdbc:postgresql://host.docker.internal:5432/fieldforcedb
FIELDFORCE_DB_USERNAME=fieldforcedb
# gst-service (Option A GST platform)
GST_DB_URL=jdbc:postgresql://host.docker.internal:5432/gstdb
GST_DB_USERNAME=gstdb
GST_DB_PASSWORD=gstdb
# ledger-service (trade GL)
LEDGER_DB_URL=jdbc:postgresql://host.docker.internal:5432/ledgerdb
LEDGER_DB_USERNAME=ledgerdb
LEDGER_DB_PASSWORD=ledgerdb
# Set true after gst-service is running to route POS tax via gst-service
GST_INTEGRATION_ENABLED=true
GST_INTEGRATION_BASE_URL=http://gst-service:8091
# Supplier GSTIN auto-fill.
# Local freemode (default for demos): gst-mock-service — free, offline, Sandbox-compatible.
# Production: set BASE_URL=https://api.sandbox.co.in and real Sandbox key/secret.
GST_VERIFICATION_ENABLED=true
GST_VERIFICATION_BASE_URL=http://gst-mock-service:8099
GST_VERIFICATION_API_KEY=mock-dev-key
GST_VERIFICATION_API_SECRET=mock-dev-secret

# AI Product Capture — set a vision LLM key so pack photos fill name/barcode/MRP.
# Without this, the UI shows "vision AI key is not set" and engine=HEURISTIC.
PRODUCT_CAPTURE_ENABLED=true
PRODUCT_CAPTURE_LLM_API_KEY=
# PRODUCT_CAPTURE_LLM_BASE_URL=https://api.openai.com/v1
# PRODUCT_CAPTURE_LLM_MODEL=gpt-4o-mini
# GST_MOCK_DATASET_SIZE=10000
# GST_MOCK_SERVICE_HOST_PORT=8099
LEDGER_INTEGRATION_ENABLED=true
LEDGER_INTEGRATION_BASE_URL=http://ledger-service:8094
# Optional: override container pool when tuning Postgres (default 10 in docker-compose for fieldforce-service).
# FIELDFORCE_DB_HIKARI_MAX_POOL=10
ACCOUNT_DB_URL=jdbc:postgresql://host.docker.internal:5432/accountdb
ACCOUNT_DB_USERNAME=accountdb

# IPD + beds (optional compose profile ipd — .\scripts\start-local-ipd.ps1)
# Host DB matches local Maven (postgres / ipddb). Override if you created a dedicated user.
# IPD_DB_URL=jdbc:postgresql://host.docker.internal:5432/ipddb
# IPD_DB_USERNAME=postgres
# IPD_DB_PASSWORD=postgres
# IPD_IMAGE_TAG=1.0.4
# ACCOMMODATION_IMAGE_TAG=1.0.2
# GATEWAY_IPD_URI=http://ipd-service:8100
# GATEWAY_ACCOMMODATION_URI=http://accommodation-service:8101

# Polyclinic (doctor-service, appointment-service, queue-management-service)
# Bootstrap: infra/postgres/create-polyclinic-databases.sql (or fix-polyclinic-databases.sql if DBs exist)
DOCTOR_DB_URL=jdbc:postgresql://host.docker.internal:5432/doctordb
DOCTOR_DB_USERNAME=doctordb
APPOINTMENT_DB_URL=jdbc:postgresql://host.docker.internal:5432/appointmentdb
APPOINTMENT_DB_USERNAME=appointmentdb
QUEUE_DB_URL=jdbc:postgresql://host.docker.internal:5432/queuedb
QUEUE_DB_USERNAME=queuedb

# Optional: gateway bypass for polyclinic services
# GATEWAY_DOCTOR_URI=http://doctor-service:8092
# GATEWAY_APPOINTMENT_URI=http://appointment-service:8093
# GATEWAY_QUEUE_URI=http://queue-management-service:8098

# Optional: gateway bypass when Eureka has no field-force instance yet (Compose default in docker-compose.yml).
# GATEWAY_FIELDFORCE_URI=http://fieldforce-service:8090
# GATEWAY_GST_URI=http://gst-service:8091
#
# If Compose reports "fieldforce-service:... not found" on Docker Hub, either:
#   .\compose-local.ps1 build fieldforce-service
#   .\compose-local.ps1 up -d --build
# or rely on pull_policy: build on fieldforce-service in docker-compose.yml (local dev).
#
# Optional compose / build:
# SPRING_PROFILES_ACTIVE=prod
#
# --- EC2 + docker-compose.ec2-rds.yml (pull from registry) ---
# Copy .env.production.example -> .env.production on the server; do NOT reuse .env.local.
# IMAGE_TAG must exist on Docker Hub/ECR for every service (e.g. 1.0.0). Avoid "latest"
# unless you publish :latest for all images — otherwise "not found" on pull.
# EC2 RDS: create fieldforcedb + gstdb on RDS; set FIELDFORCE_DB_* and GST_DB_* URLs in .env.production.
# IMAGE_TAG=1.0.0
# IMAGE_PREFIX=sumanthakur30
# Docker Hub with repo prefix: IMAGE_PREFIX=sumanthakur30/sugamflow
# ECR: IMAGE_PREFIX=123456789012.dkr.ecr.ap-south-1.amazonaws.com/sugamflow
#
# --- Local docker-compose.yml (build / tag names) ---
# Default in compose: sumanthakur30/<service>:<IMAGE_TAG>. Keep IMAGE_TAG aligned with
# what you push so local tags match EC2 pulls.
# IMAGE_PREFIX=sumanthakur30
# SECURITY_JWT_SECRET=at_least_32_characters_for_hs256________
# Canonical host ports (match in-container). Override only if :8761/:8888 are taken.
# CONFIG_SERVICE_HOST_PORT=8888
# DISCOVERY_SERVICE_HOST_PORT=8761
# Legacy (do not use for School): 18888 / 18761
#
# --- Product import queue (optional RabbitMQ) ---
# Default: queue off — uploads work; jobs stay PENDING until async worker runs.
# Local Grafana/Loki/Tempo (observability/docker-compose.observability.yml).
# Compose services must use host.docker.internal, not 127.0.0.1, to reach the collector.
OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4318
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
SUGAM_ENVIRONMENT=local
SUGAM_OBSERVABILITY_ENABLED=true

# When RabbitMQ pull succeeds: docker compose --profile queue up -d rabbitmq
# then set:
# PRODUCT_IMPORT_QUEUE_ENABLED=true
# SPRING_RABBIT_AUTOCONFIGURE_EXCLUDE=
# RABBITMQ_USERNAME=sugamflow
# RABBITMQ_PASSWORD=sugamflow

# Amazon India Selling Partner (marketplace profile). Do not put the Seller Central password here.
# Create the app in Seller Central and set the redirect to:
#   http://localhost:4200/settings?section=integrations
# MARKETPLACE_DB_URL=jdbc:postgresql://host.docker.internal:5432/marketplacedb
# MARKETPLACE_DB_USERNAME=marketplacedb
# MARKETPLACE_DB_PASSWORD=marketplacedb
# MARKETPLACE_AMAZON_APPLICATION_ID=
# MARKETPLACE_AMAZON_LWA_CLIENT_ID=
# MARKETPLACE_AMAZON_LWA_CLIENT_SECRET=
# MARKETPLACE_AMAZON_AWS_ACCESS_KEY_ID=
# MARKETPLACE_AMAZON_AWS_SECRET_ACCESS_KEY=
# MARKETPLACE_AMAZON_REGION=eu-west-1
# MARKETPLACE_AMAZON_ENDPOINT=https://sellingpartnerapi-eu.amazon.com
# MARKETPLACE_AMAZON_MARKETPLACE_ID=A21TJRUUN4KGV
# MARKETPLACE_AMAZON_DRAFT_CONSENT=true
# MARKETPLACE_AMAZON_AUTHORIZE_URL=https://sellercentral.amazon.in/apps/authorize/consent
