# Copy to .env.production on EC2. Replace placeholders. Do NOT commit .env.production.



SPRING_PROFILES_ACTIVE=prod

IMAGE_PREFIX=sumanthakur30

# Default tag for most microservices (config, gateway, shop, product, stock, …)
IMAGE_TAG=1.0.0

FIELDFORCE_IMAGE_TAG=1.0.0

GST_IMAGE_TAG=1.0.0

LEDGER_IMAGE_TAG=1.0.0

# order-service only — bump alone after wholesale/HIS Flyway without retagging the whole stack
ORDER_IMAGE_TAG=1.0.1

# Hospital IPD overlay (docker-compose.ec2-ipd.yml) — default falls back to IMAGE_TAG if unset
IPD_IMAGE_TAG=1.0.2
ACCOMMODATION_IMAGE_TAG=1.0.2
# Product CRM (Compose profile crm) — push crm-service then set tag
CRM_IMAGE_TAG=1.0.5



JAVA_TOOL_OPTIONS=-Duser.timezone=Asia/Kolkata -Xms128m -Xmx256m -XX:+ExitOnOutOfMemoryError

GATEWAY_JAVA_TOOL_OPTIONS=-Duser.timezone=Asia/Kolkata -Xms128m -Xmx384m -XX:+ExitOnOutOfMemoryError

# Docker mem_limit per JVM container (see docker-compose.ec2-rds.yml x-jvm-service)
JVM_SERVICE_MEM_LIMIT=400m
GATEWAY_SERVICE_MEM_LIMIT=640m
DISCOVERY_SERVICE_MEM_LIMIT=512m
REDIS_MEM_LIMIT=128m

DB_POOL_MAX_SIZE=3

FIELDFORCE_DB_HIKARI_MAX_POOL=4

GST_DB_HIKARI_MAX_POOL=4

LEDGER_DB_HIKARI_MAX_POOL=8

DOCTOR_DB_HIKARI_MAX_POOL=4

APPOINTMENT_DB_HIKARI_MAX_POOL=4

QUEUE_DB_HIKARI_MAX_POOL=4



SECURITY_JWT_SECRET=CHANGE_ME_at_least_32_chars_for_hs256____

SECURITY_JWT_ENFORCE=true

SECURITY_INVITE_INTERNAL_KEY=CHANGE_ME_invite_internal_key________

# School ERP EMAIL delivery: must match School .env.school.production SECURITY_INTERNAL_API_KEY
# (use the same value as SECURITY_INVITE_INTERNAL_KEY unless you intentionally split keys).
SECURITY_INTERNAL_API_KEY=CHANGE_ME_invite_internal_key________

SHOP_ADMIN_API_KEY=CHANGE_ME_shop_admin_api_key_______________

# Same value as SECURITY_INVITE_INTERNAL_KEY (required for polyclinic dashboard / module gates on order-service).
SECURITY_ENTITLEMENT_GATE_INTERNAL_API_KEY=CHANGE_ME_invite_internal_key________



# All *_DB_URL (example — one per service on RDS)

# AUTH_DB_URL=jdbc:postgresql://YOUR_RDS:5432/authdb?sslmode=require

# STOCK_DB_URL=jdbc:postgresql://YOUR_RDS:5432/stockdb?sslmode=require

# LEDGER_DB_URL=jdbc:postgresql://YOUR_RDS:5432/ledgerdb?sslmode=require
# LEDGER_DB_USERNAME=ledgerdb
# LEDGER_DB_PASSWORD=CHANGE_ME

# GST_DB_URL=jdbc:postgresql://YOUR_RDS:5432/gstdb?sslmode=require

# ... userdb, shopdb, productdb, orderdb, paymentdb, notificationdb, reportingdb,

#     accountdb, fieldforcedb, gstdb, ledgerdb, doctordb, appointmentdb, queuedb

# Polyclinic bootstrap: infra/postgres/create-polyclinic-databases.sql

# Ledger bootstrap: infra/postgres/rds-create-ledger.sql

# Fieldforce + GST DBs: infra/postgres/rds-create-fieldforce-gst.sql

# IPD + Accommodation Engine (shared ipddb) — see scripts/rds-ipd-accommodation/README.md
# IPD_DB_URL=jdbc:postgresql://YOUR_RDS:5432/ipddb?sslmode=require
# IPD_DB_USERNAME=postgres
# IPD_DB_PASSWORD=CHANGE_ME
# (IPD_IMAGE_TAG / ACCOMMODATION_IMAGE_TAG also set near IMAGE_TAG above)

# Product CRM — create DB: infra/postgres/rds-create-crm.sql ; start: scripts/ec2-start-crm.sh
# CRM_DB_URL=jdbc:postgresql://YOUR_RDS:5432/crmdb?sslmode=require
# CRM_DB_USERNAME=crmdb
# CRM_DB_PASSWORD=CHANGE_ME
# CRM_SERVICE_MEM_LIMIT=400m
# CRM_ENTITLEMENT_ENABLED=false
# CRM_CONVERT_ENABLED=false
# CRM_ORDER_ENABLED=false
# CRM_NOTIFICATION_ENABLED=false
# CRM_AI_PROVIDER=HEURISTIC
# ACCOMMODATION_SERVICE_BASE_URL=http://accommodation-service:8101
# ORDER_SERVICE_BASE_URL=http://order-service:8083
# ORDER_BILLING_SYNC_ENABLED=true
# GATEWAY_IPD_URI=http://ipd-service:8100
# GATEWAY_ACCOMMODATION_URI=http://accommodation-service:8101
# Deploy overlay: docker compose -f docker-compose.ec2-rds.yml -f docker-compose.ec2-ipd.yml --env-file .env.production up -d



GST_INTEGRATION_ENABLED=true

GST_INTEGRATION_BASE_URL=http://gst-service:8091

LEDGER_INTEGRATION_ENABLED=true

LEDGER_INTEGRATION_BASE_URL=http://ledger-service:8094

# Supplier GSTIN verification — production uses real Sandbox (NOT gst-mock-service).
GST_VERIFICATION_ENABLED=false
GST_VERIFICATION_BASE_URL=https://api.sandbox.co.in
GST_VERIFICATION_API_KEY=CHANGE_ME
GST_VERIFICATION_API_SECRET=CHANGE_ME

SHOP_INTEGRATION_FIELDFORCE_BASE_URL=http://fieldforce-service:8090

AUTH_INTEGRATION_FRONTEND_BASE_URL=https://sugamflow.com

SHOP_INTEGRATION_FRONTEND_BASE_URL=https://sugamflow.com

PRODUCT_IMPORT_QUEUE_ENABLED=false

# AI Product Capture (product-service vision extract). Empty key = HEURISTIC only (no pack photo read).
# Get a key from OpenAI (or any OpenAI-compatible vision endpoint), then on EC2:
#   bash scripts/ec2-set-product-capture-llm.sh 'sk-...'
PRODUCT_CAPTURE_ENABLED=true
PRODUCT_CAPTURE_LLM_API_KEY=
# PRODUCT_CAPTURE_LLM_BASE_URL=https://api.openai.com/v1
# PRODUCT_CAPTURE_LLM_MODEL=gpt-4o-mini

# Flyway runs automatically on service startup. Manual SQL only if Flyway failed.



# Gateway — Compose service DNS (do NOT use SPRING_CLOUD_GATEWAY_SERVER_WEBFLUX_ROUTES_*)

GATEWAY_AUTH_URI=http://auth-service:8085

GATEWAY_ORDER_URI=http://order-service:8083

GATEWAY_STOCK_URI=http://stock-service:8082

GATEWAY_PRODUCT_URI=http://product-service:8081

GATEWAY_USER_URI=http://user-service:8084

GATEWAY_SHOP_URI=http://shop-service:8080

GATEWAY_ACCOUNT_URI=http://account-service:8089

GATEWAY_PAYMENT_URI=http://payment-service:8086

GATEWAY_NOTIFICATION_URI=http://notification-service:8087

GATEWAY_REPORTING_URI=http://reporting-service:8088

GATEWAY_FIELDFORCE_URI=http://fieldforce-service:8090

GATEWAY_GST_URI=http://gst-service:8091

GATEWAY_LEDGER_URI=http://ledger-service:8094

GATEWAY_DOCTOR_URI=http://doctor-service:8092

GATEWAY_APPOINTMENT_URI=http://appointment-service:8093

GATEWAY_QUEUE_URI=http://queue-management-service:8098

# Product CRM (opt-in Compose profile "crm") — see scripts/ec2-start-crm.sh
GATEWAY_CRM_URI=http://crm-service:8095

# Shop UI origin for browser CORS (must match where Angular is served)

GATEWAY_CORS_ALLOWED_ORIGIN_PATTERN=https://app.sugamflow.com



# SMTP for notification-service (School ERP EMAIL: admission/fee/comms).
# Do NOT leave HOST=localhost on EC2.
# Zoho (sugamflow.com MX → zoho.in):
SPRING_MAIL_HOST=smtp.zoho.in
SPRING_MAIL_PORT=587
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS_ENABLE=true
SPRING_MAIL_USERNAME=career@sugamflow.com
SPRING_MAIL_PASSWORD=CHANGE_ME_zoho_mailbox_password
# Must match authenticated mailbox (Zoho rejects missing/wrong From)
SPRING_MAIL_FROM=career@sugamflow.com

# --- School ERP SMS / WhatsApp (notification-service) ---
# stub | twilio | msg91 (SMS) | http
NOTIFICATION_SMS_PROVIDER=twilio
NOTIFICATION_WHATSAPP_PROVIDER=twilio
NOTIFICATION_DEFAULT_COUNTRY_CODE=91
TWILIO_ACCOUNT_SID=CHANGE_ME_ACxxxxxxxx
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_SMS_FROM=+1CHANGE_ME
# Trial sandbox (after phone joins sandbox). Production: approved WhatsApp sender.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Optional India SMS alternative
MSG91_AUTH_KEY=
MSG91_SENDER=
MSG91_ROUTE=4

# Observability — fail-open to the EC2 loopback. Do not deploy Tempo/Loki/Grafana on this host.
# After Grafana Cloud OTLP is ready, set endpoint to https://otlp-gateway-….grafana.net/otlp
# and OTEL_EXPORTER_OTLP_AUTHORIZATION=Basic <base64(instanceId:token)>. Never commit the token.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_AUTHORIZATION=
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.15
SUGAM_ENVIRONMENT=prod

